# Minimal privoxy: a localhost HTTP CONNECT bridge onto the NetBird SOCKS5
# listener, hostname passed through for remote resolution (forward-socks5
# resolves at the SOCKS server). No filtering, no actions — privoxy exists
# here only because Claude Code speaks HTTP proxies and NetBird speaks SOCKS5.
# __SOCKS_ADDR__ is substituted by bridge-entry.sh from the pod environment.
listen-address 127.0.0.1:8118
forward-socks5 / __SOCKS_ADDR__ .
toggle 0
confdir /etc/privoxy
logdir /run/bridge
debug 1
